{
  "_meta": {
    "id": "image_sdxl_i2i",
    "name": "SDXL image-to-image",
    "type": "image",
    "mode": "image-to-image",
    "description": "Rework an uploaded reference image with SDXL. Strength controls how much of the original is kept.",
    "requires_model": "sdxl",
    "min_vram_gb": 10,
    "max_width": 1536,
    "max_height": 1536,
    "features": ["prompt", "negative_prompt", "seed", "steps", "cfg", "strength", "aspect_ratio"],
    "needs_upload": true,
    "experimental": false,
    "install_hint": "Download SDXL base from the notebook Model download manager (preset: Balanced).",
    "param_map": {
      "prompt": {"node": "1", "field": "text"},
      "negative_prompt": {"node": "2", "field": "text"},
      "strength": {"node": "3", "field": "denoise"},
      "steps": {"node": "3", "field": "steps"},
      "cfg": {"node": "3", "field": "cfg"},
      "seed": {"node": "3", "field": "seed"},
      "width": {"node": "8", "field": "width"},
      "height": {"node": "8", "field": "height"},
      "image": {"node": "7", "field": "image"},
      "model": {"node": "0", "field": "ckpt_name"}
    }
  },
  "0": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}},
  "1": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["0", 1]}},
  "2": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["0", 1]}},
  "3": {"class_type": "KSampler", "inputs": {"seed": 0, "steps": 30, "cfg": 6.5, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 0.6, "model": ["0", 0], "positive": ["1", 0], "negative": ["2", 0], "latent_image": ["8", 0]}},
  "5": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["0", 2]}},
  "6": {"class_type": "SaveImage", "inputs": {"images": ["5", 0], "filename_prefix": "OpenGenerativeAI/image"}},
  "7": {"class_type": "LoadImage", "inputs": {"image": "input.png", "upload": "image"}},
  "8": {"class_type": "ImageScale", "inputs": {"width": 1024, "height": 1024, "upscale_method": "nearest", "crop": "disabled", "image": ["7", 0]}},
  "9": {"class_type": "VAEEncode", "inputs": {"pixels": ["8", 0], "vae": ["0", 2]}}
}

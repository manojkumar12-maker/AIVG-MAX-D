{
  "_meta": {
    "id": "image_sdxl_t2i",
    "name": "SDXL text-to-image",
    "type": "image",
    "mode": "text-to-image",
    "description": "High-quality text-to-image with SDXL base 1.0. Needs ~12GB VRAM; use the low-VRAM preset below that.",
    "requires_model": "sdxl",
    "min_vram_gb": 10,
    "max_width": 1536,
    "max_height": 1536,
    "features": ["prompt", "negative_prompt", "seed", "steps", "cfg", "sampler", "scheduler", "batch_size", "aspect_ratio"],
    "needs_upload": false,
    "experimental": false,
    "install_hint": "Download SDXL base from the notebook Model download manager (preset: Balanced).",
    "param_map": {
      "prompt": {"node": "1", "field": "text"},
      "negative_prompt": {"node": "2", "field": "text"},
      "width": {"node": "4", "field": "width"},
      "height": {"node": "4", "field": "height"},
      "batch_size": {"node": "4", "field": "batch_size"},
      "steps": {"node": "3", "field": "steps"},
      "cfg": {"node": "3", "field": "cfg"},
      "seed": {"node": "3", "field": "seed"},
      "sampler": {"node": "3", "field": "sampler_name"},
      "scheduler": {"node": "3", "field": "scheduler"},
      "model": {"node": "0", "field": "ckpt_name"}
    }
  },
  "0": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}},
  "1": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["0", 1]}},
  "2": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["0", 1]}},
  "3": {"class_type": "KSampler", "inputs": {"seed": 0, "steps": 30, "cfg": 6.5, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0, "model": ["0", 0], "positive": ["1", 0], "negative": ["2", 0], "latent_image": ["4", 0]}},
  "4": {"class_type": "EmptyLatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
  "5": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["0", 2]}},
  "6": {"class_type": "SaveImage", "inputs": {"images": ["5", 0], "filename_prefix": "OpenGenerativeAI/image"}}
}
